# Humanline worker configuration.
# Copy to worker/.env (git-ignored) or put the secret in repo-root .secrets.env.
# The worker loads, in order and without overriding anything already in the environment:
#   1. --env-file <path>   2. worker/.env   3. ../.secrets.env

# --- required to submit transactions (read-only commands work without it) ---
# Relayer/deployer key. Never printed by the CLI. 0x-prefixed or bare hex.
CREDITCOIN_WALLET_PRIVATE_KEY=

# --- source chains ---
# Ethereum mainnet, Attestcoin chainKey 3, World ID Orb manager 0xf7134CE1…bddEa.
# NOTE: the public default below rejects eth_getLogs ("Archive requests require a personal
# token"), so the worker automatically fails over to a working endpoint. Set this to your
# own archive-capable RPC for production relaying. A comma-separated list is accepted.
ETH_MAINNET_RPC=https://ethereum-rpc.publicnode.com

# Ethereum Sepolia, Attestcoin chainKey 1, World ID staging manager 0xb2ead588…7076.
ETH_SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com

# --- Creditcoin CC3 testnet ---
CC3_RPC=https://rpc.cc3-testnet.creditcoin.network
PROVER_URL=https://prover.cc3-testnet.creditcoin.network

# --- paths ---
# Deployment addresses: { chainId, contracts: { AttestedWorldIDMainnet, AttestedWorldIDSepolia,
# HUSD, HumanRegistry, CreditLine, HumanGate } }. Relative paths resolve against the CWD
# when set here, and against worker/ when left at the default.
DEPLOYMENTS_FILE=../deployments/cc3-testnet.json

# Append-only relay evidence, relative to the repo root.
EVIDENCE_FILE=evidence/relay-log.jsonl

# Cursor and per-transaction state, relative to worker/. Use :memory: for throwaway runs.
WORKER_DB=data/relay.db
